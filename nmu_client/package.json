{
    "name": "nmu_client",
    "version": "0.1.0",
    "private": true,
    "scripts": {
        "dev": "concurrently -k -n CODEGEN,NEXT -c yellow,cyan \"pnpm codegen:watch\" \"next dev --turbopack\"",
        "build": "next build",
        "start": "next start",
        "lint": "next lint",
        "codegen": "graphql-codegen --config graphql.config.ts",
        "codegen:watch": "graphql-codegen --config graphql.config.ts --watch"
    },
    "dependencies": {
        "@ant-design/icons": "~5.6.1",
        "@apollo/client": "^3.13.8",
        "antd": "^5.25.3",
        "dotenv-flow": "^4.1.0",
        "i18next": "^25.2.1",
        "lucide-react": "^0.513.0",
        "next": "15.3.2",
        "next-i18next": "^15.4.2",
        "react": "^19.0.0",
        "react-dom": "^19.0.0",
        "react-i18next": "^15.5.2",
        "react-responsive": "^10.0.1",
        "react-toastify": "^11.0.5",
        "zustand": "^5.0.5"
    },
    "devDependencies": {
        "@eslint/eslintrc": "^3",
        "@graphql-codegen/cli": "^5.0.6",
        "@graphql-codegen/client-preset": "^4.8.1",
        "@graphql-codegen/typescript": "^4.1.6",
        "@graphql-codegen/typescript-operations": "^4.6.1",
        "@graphql-codegen/typescript-react-apollo": "^4.3.3",
        "@graphql-typed-document-node/core": "^3.2.0",
        "@parcel/watcher": "^2.5.1",
        "@types/node": "^20",
        "@types/react": "^19",
        "@types/react-dom": "^19",
        "concurrently": "^9.1.2",
        "dotenv": "^16.5.0",
        "eslint": "^9",
        "eslint-config-next": "15.3.2",
        "graphql": "^16.11.0",
        "sass": "^1.89.0",
        "typescript": "^5"
    }
}
